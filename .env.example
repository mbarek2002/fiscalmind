APP_NAME=FiscalMind API
ENVIRONMENT=dev

SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=postgresql+asyncpg://fiscalmind:fiscalmind@localhost:5432/fiscalmind
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=
QDRANT_COLLECTION_LOI=loi_finance
QDRANT_VECTOR_SIZE=64
RERANKER_PROVIDER=local
LOCAL_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
